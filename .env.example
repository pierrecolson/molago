# --- App (Vercel) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Secret d'accès mono-utilisateur : /login?key=<APP_SECRET> pose le cookie.
APP_SECRET=change-me

# --- Pipeline (GitHub Actions secrets + .env local) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# Clé API krdict (gratuite) : https://krdict.korean.go.kr/openApi/openApiInfo
KRDICT_API_KEY=...
# Modèle Kiwi (télécharger l'asset "model_base" d'une release https://github.com/bab2min/Kiwi/releases)
KIWI_MODEL_URL=https://github.com/bab2min/Kiwi/releases/download/v0.21.0/kiwi_model_v0.21.0_base.tgz
KIWI_MODEL_DIR=.kiwi-model
# Relance du pipeline depuis l'app (bouton "relancer") : token GitHub fine-grained, scope Actions RW
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=pierrecolson/molago
